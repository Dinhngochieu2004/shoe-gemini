# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (thay USER/PASSWORD/cluster của bạn)
CONNECT_DB=mongodb://USER:PASSWORD@your-cluster-host:27017/shoe?ssl=true&replicaSet=YOUR_REPLICA_SET&authSource=admin
# Redis Cloud connection string
CONNECT_REDIS=redis://default:YOUR_REDIS_PASSWORD@your-redis-host:PORT

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Chuỗi ngẫu nhiên dài, KHÁC nhau giữa access và refresh
JWT_ACCESS_KEY=change_me_random_access_key
JWT_REFRESH_KEY=change_me_random_refresh_key

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
# npm start trực tiếp — Docker override bằng environment: trong docker-compose.yml
SERVER_URL=http://localhost:5001

# ─── Client URL (CORS) ────────────────────────────────────────────────────────
# npm start trực tiếp — Docker override bằng environment: trong docker-compose.yml
REACT_APP_URL=http://localhost:3000
REACT_APP_URL_DOMAIN=http://localhost:3000
# Production — override bằng environment trong docker-stack.yml
# REACT_APP_URL=https://your-domain.example

# ─── Email (Gmail OAuth2) ─────────────────────────────────────────────────────
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
REFRESH_TOKEN=

# ─── Payment — MoMo ───────────────────────────────────────────────────────────
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key

# ─── Payment — VNPay ──────────────────────────────────────────────────────────
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECURE_SECRET=your_vnpay_secure_secret

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
